---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for p in site.html_pages %}{% unless p.noindex %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    {%- if p.alt %}
    <xhtml:link rel="alternate" hreflang="{{ p.lang }}" href="{{ site.url }}{{ p.url }}"/>
    <xhtml:link rel="alternate" hreflang="{% if p.lang == 'en' %}tr{% else %}en{% endif %}" href="{{ site.url }}{{ p.alt }}"/>
    {%- endif %}
  </url>
{%- endunless %}{% endfor %}
</urlset>
